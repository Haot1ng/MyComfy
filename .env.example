# 在仓库根目录运行 sh scripts/init-env.sh 生成 .env，再填写两个密码。
# 可以分别运行 openssl rand -hex 32 生成密码，把输出粘贴到等号右边。
# 下面的账号和密码会用于默认连接串，可直接使用字母、数字和 - . _ ~。
# MySQL 首次启动时创建账号。复用已有数据卷时填写已有账号和密码。
MYSQL_USER=mycomfy
MYSQL_PASSWORD=

# default 是 Redis 内置账号。也可以填自定义用户名，例如 mycomfy_cache。
REDIS_USER=default
REDIS_PASSWORD=

# 初始化脚本自动填入当前 Linux 或 WSL 用户的 UID/GID。指定服务账号时可手动修改。
MYCOMFY_UID=
MYCOMFY_GID=

# 从仓库根目录运行 docker compose，PWD 会展开成当前目录的绝对路径。
MYCOMFY_DATA_ROOT="${PWD}/var/data"

# 可选。只有本机端口冲突时才需要修改。
# MYCOMFY_MYSQL_PORT=3306
# MYCOMFY_REDIS_PORT=6379
# MYCOMFY_API_PORT=8000
# MYCOMFY_LOCAL_PORT=8001
