# 手动填密码时，用 sh scripts/init-env.sh 生成 .env。一键部署会在首次运行时自动生成密码。
# 可以分别运行 openssl rand -hex 32 生成密码，把输出粘贴到等号右边。
# 下面的账号和密码会用于默认连接串，可直接使用字母、数字和 - . _ ~。
# MySQL 首次启动时创建账号。复用已有数据卷时填写已有账号和密码。
MYSQL_USER=mycomfy
MYSQL_PASSWORD=

# default 是 Redis 内置账号。也可以填自定义用户名，例如 mycomfy_cache。
REDIS_USER=default
REDIS_PASSWORD=

# 初始化脚本自动填入当前 Linux 或 WSL 用户的 UID/GID。指定服务账号时可手动修改。
MYCOMFY_UID=
MYCOMFY_GID=

# 从仓库根目录运行 docker compose，PWD 会展开成当前目录的绝对路径。
MYCOMFY_DATA_ROOT="${PWD}/var/data"

# 连接外部实例时填业务机可达的地址。省略时业务端连本机回环地址，
# GPU 容器通过同一 Compose 网络内的 mysql:3306 连接数据库。
# MYCOMFY_MYSQL_HOST=mysql.internal
# MYCOMFY_REDIS_HOST=redis.internal
# MYCOMFY_MYSQL_PORT=3306
# MYCOMFY_REDIS_PORT=6379
# 外部 MySQL 使用非 3306 端口时，也请设置 MYCOMFY_ENGINE_MYSQL_PORT。
# 若在此文件显式填写 MYCOMFY_MYSQL_HOST=127.0.0.1，同时使用本项目自带数据库，
# 请设置 MYCOMFY_ENGINE_MYSQL_HOST=mysql 和 MYCOMFY_ENGINE_MYSQL_PORT=3306。
# .env 直配 IPv6 连接地址请使用方括号，例如 [fd00::10]。
# MYCOMFY_ENGINE_MYSQL_HOST=mysql.internal
# MYCOMFY_ENGINE_MYSQL_PORT=3306

# 仅影响自带数据库对外发布的宿主 IP。分机时可填数据库机器的私网 IP。
# MYCOMFY_MYSQL_BIND_HOST=127.0.0.1
# MYCOMFY_REDIS_BIND_HOST=127.0.0.1

# 业务与管理监听端口。
# MYCOMFY_API_PORT=8000
# MYCOMFY_LOCAL_PORT=8001
