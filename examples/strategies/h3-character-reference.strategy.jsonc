// MyComfy 管理后台 → 工作流模板 → 打开 JSON 文件。选中后可预览节点并发布。
// 主图确定角色，最多两张补图提供同一角色的其他视角或细节。文字决定动作与场景。
{
  "strategy_key": "minimax-h3-character-reference", // 模板系列标识；再次发布同名系列会创建新版本。
  "name": "MiniMax H3 · 角色参考与动作",
  "workflow": {
    // [节点 ID, 输出序号] 表示 ComfyUI 节点连线。编号 6、13、11、24 加载本图使用的四份权重。
    "6": {
      "class_type": "UNETLoader",
      "inputs": {"unet_name": "minimax_h3_ref2va_pruned_int8_convrot.safetensors", "weight_dtype": "default"}
    },
    "13": {
      "class_type": "CLIPLoader",
      "inputs": {"clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors", "type": "minimax", "device": "default"}
    },
    "11": {"class_type": "VAELoader", "inputs": {"vae_name": "minimax_h3_video_vae_int8_convrot.safetensors"}},
    "24": {"class_type": "VAELoader", "inputs": {"vae_name": "minimax_h3_audio_vae_fp32.safetensors"}},
    "114": {
      "class_type": "LoadImage",
      "inputs": {"image": "reference.png"} // Worker 在执行时填入本次上传图片的文件名。
    },
    "115": {"class_type": "LoadImage", "inputs": {"image": ""}}, // 未上传补充图 2 时，Worker 移除此节点。
    "116": {"class_type": "LoadImage", "inputs": {"image": ""}}, // 补充图 3 可单独搭配主图。
    "36": {
      "class_type": "StringConcatenate",
      "inputs": {
        "string_a": "以 <Picture 1> 中动作描述所指的主体为主角，保持其辨识特征与外观连续。如有补充参考图，结合其中同一主体的其他视角或细节。以动作描述指定的场景、初始姿态和镜头开始拍摄。",
        "string_b": "", // 用户输入的动作与场景，或用户手动采用的扩写结果。
        "delimiter": "\n" // 换行后接动作描述。固定参考标记在整个过程中保留。
      }
    },
    "104": {
      "class_type": "MiniMaxH3ReferenceToVideo",
      "inputs": {
        "clip": ["13", 0],
        "vae": ["11", 0],
        "audio_vae": ["24", 0],
        "prompt": ["36", 0],
        "ref_images.ref_image_0": ["114", 0], // 第一张参考图对应提示词中的 <Picture 1>。
        "ref_images.ref_image_1": ["115", 0], // 没传图 2 时，Worker 移除此连线和对应的读取节点。
        "ref_images.ref_image_2": ["116", 0], // 没传图 3 时同理。模型按实际收到的图片顺序编号。
        "ref_image_size": "match", // 按生成画布的像素规模处理参考图。
        "width": 640, "height": 384,
        "length": 124 // 17 × 7 + 5 帧，按 24 fps 播放约 5.17 秒。
      }
    },
    "15": {"class_type": "RandomNoise", "inputs": {"noise_seed": 791336}},
    "16": {"class_type": "BasicGuider", "inputs": {"model": ["6", 0], "conditioning": ["104", 0]}},
    "17": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "res_multistep"}},
    "9": {
      "class_type": "BasicScheduler",
      "inputs": {"model": ["6", 0], "scheduler": "beta", "steps": 20, "denoise": 1.0} // 使用基础权重采样。
    },
    "14": {
      "class_type": "SamplerCustomAdvanced",
      "inputs": {
        "noise": ["15", 0], "guider": ["16", 0], "sampler": ["17", 0],
        "sigmas": ["9", 0], "latent_image": ["104", 1] // R2V 的第二路输出给出联合音视频潜变量。
      }
    },
    "10": {"class_type": "VAEDecode", "inputs": {"samples": ["14", 0], "vae": ["11", 0]}},
    "23": {"class_type": "VAEDecodeAudio", "inputs": {"samples": ["14", 0], "vae": ["24", 0]}},
    "91": {"class_type": "CreateVideo", "inputs": {"images": ["10", 0], "audio": ["23", 0], "fps": 24, "bit_depth": 8}},
    "92": {
      "class_type": "SaveVideo",
      "inputs": {"video": ["91", 0], "filename_prefix": "video/H3_Character", "format": "mp4", "codec": "auto"}
    }
  },
  "input_schema": {
    "type": "object",
    "properties": {
      "reference_image": {
        "type": "string", "minLength": 1,
        "title": "角色主参考图（必传）",
        "description": "上传一张能看清主角的图片。多人合影可先裁出主角，也可以在下方写明角色的位置和特征。"
      },
      "reference_image_2": {
        "type": "string", "minLength": 1,
        "title": "补充参考图 2（选传）",
        "description": "可上传同一角色的侧面或四分之三视角，例如补充转头时能看到的特征。"
      },
      "reference_image_3": {
        "type": "string", "minLength": 1,
        "title": "补充参考图 3（选传）",
        "description": "可上传同一角色的全身或局部细节。只传主图和这张图也可以。"
      },
      "prompt": {
        "type": "string", "minLength": 1, "maxLength": 8000,
        "title": "场景与动作",
        "description": "描述角色在哪里、先做什么、接着做什么，以及镜头怎样拍摄。模板会自动引用上面的角色图。",
        "default": "雨夜站台，中景固定镜头。主角听到汽笛后转头望向左侧，随后提起脚边的旅行袋，朝刚停下的列车走去。"
      }
    },
    "required": ["reference_image", "prompt"],
    "additionalProperties": false
  },
  "bindings": [
    {"input": "reference_image", "node_id": "114", "node_input": "image", "kind": "asset"}, // 生成上传控件。
    {"input": "reference_image_2", "node_id": "115", "node_input": "image", "kind": "asset", "omit_node_if_missing": true},
    {"input": "reference_image_3", "node_id": "116", "node_input": "image", "kind": "asset", "omit_node_if_missing": true},
    {"input": "prompt", "node_id": "36", "node_input": "string_b", "kind": "value"} // 用户只需输入动作文字。
  ],
  "prompt_assist": {
    "fields": ["prompt"], // 仅发送用户主动选择扩写的文字，图片留在视频生成流程。
    "instructions": "你为 MiniMax H3 角色参考视频扩写「场景与动作」。用用户的语言，把原文写成约 5 秒内可完成的一个连续镜头。只输出一段可直接用于生成视频的正文。\n保留用户指定的主体、辨识线索、场景、动作顺序和镜头要求。写清角色起初在做什么、接着怎样动、动作如何收尾。原文很短时，可补充自然的动作节奏或环境反应。用户指定固定镜头时保持机位固定。\n你只能看到文字。沿用用户给出的外观描述，不猜测参考图的数量或内容，不添加新角色。工作流会自动关联参考图，正文中不要写 <Picture N> 标记、标题或解释。"
  },
  "requirements": {
    "comfyui": "2f35f4a08176d993cded35dac3332be4f7287f41", // MyComfy 默认部署的 v0.33.0 提交。
    "models": { // 调度器按模型标识和文件 SHA-256 核对 GPU 实例。
      "h3-ref2va": "9255f52b6677845ad238f20dfaafa94727053694127ab7f255c048f0f9365779",
      "h3-text": "35a88d51044231fe332301d7a62aa81e3f2cba62febeb446e2c1e3e0ef76f2c6",
      "h3-video-vae": "52a2c8c73583c86e4f41cdcce3a6ad0ea562987bc0bf3d60a0cef5f5c8e60c0e",
      "h3-audio-vae": "8e505d95dd1561d47abd43d4238fd40d9bb1ae9e147ed0a4cba778d76ae4db48"
    }
  },
  "progress_mapping": [
    {"node_ids": ["114", "115", "116", "36", "104"], "stage": "读取角色参考与动作"},
    {"node_ids": ["14"], "stage": "生成角色动作"},
    {"node_ids": ["10", "23", "91", "92"], "stage": "解码与导出"}
  ],
  "output_contract": [
    {"role": "video", "node_id": "92", "media_types": ["video/mp4"], "width": 640, "height": 384, "fps": 24}
  ],
  "scheduling": {}, // 使用平台默认调度优先级。
  "retry": {}, // 使用平台默认自动重试策略。
  "artifacts": {} // 使用平台默认结果发布策略。
}
